# Copy to .env in the repo root for `docker compose up --build`
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Comma-separated allowed browser origins (nginx proxies /api on the same origin by default)
NEXORA_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# Optional override for frontend API base URL (leave blank to use nginx /api proxy)
VITE_API_BASE=

# OpenAI-compatible LLM configuration (leave LLM_API_KEY blank for heuristic mode)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENCY=8
LLM_REASONING_EFFORT=low
LLM_FALLBACK_HEURISTIC=true
